# Client defaults for every host. The server side is
# /etc/ssh/sshd_config.d/99-dotfiles-pubkey.conf (`mise run ssh`).
# IgnoreUnknown is first so Linux OpenSSH skips the macOS UseKeychain option.

Host *
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    IdentitiesOnly yes
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PreferredAuthentications publickey

# Tailnet names go through the system ssh client and MagicDNS.
# Do not use `tailscale ssh`, and do not run `tailscale set --ssh`.
Host *.ts.net
    StrictHostKeyChecking accept-new
    UpdateHostKeys yes
